# API server
PORT=8787
PUBLIC_URL=https://tickets.example.com     # used for ticket links in emails
TICKET_SECRET=change-me-to-a-long-random-string

# Email (leave SMTP_HOST empty for demo mode: emails are logged, not sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ahly Group Tickets <tickets@example.com>"

# Web app: where the API lives if it is on a different domain (build time)
VITE_API_URL=
