{
  "name": "alahly-group-tickets",
  "private": true,
  "version": "1.0.0",
  "description": "Ticketing hub for Al Ahly Stadium, Giza Zoo, the Pyramids Tethered Balloon and live events.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c red,yellow \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && NODE_ENV=production node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^10.0.11",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^7.0.0"
  }
}
